# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Cloudflare Workers staging directory — populated at build time by the
# rsync command in wrangler.jsonc. Never checked in.
/dist/

# node_modules from running scripts/ locally (e.g. the checklist PDF
# renderer in scripts/render-checklist-pdfs.mjs which needs puppeteer).
node_modules/
package-lock.json
package.json

# Voice-cloning reference audio — never commit the user's own recordings.
scripts/voice-refs/*.wav
scripts/voice-refs/*.mp3
scripts/voice-refs/*.m4a
scripts/voice-refs/*.flac

# Python bytecode cache from scripts/lib helpers.
__pycache__/
*.pyc

# Slice 4 — invoice fixture renderer output. SVG variants are
# generated deterministically by scripts/render-invoice-fixtures.mjs
# from the committed JSON fixtures in __fixtures__/synth/; never
# committed (regenerate locally / in CI as needed).
tools/invoice-decoder/__fixtures__/images/
