# Muntin Cost Index — API keys. Copy to `.env` (gitignored) and fill in.
#   cp .env.example .env   # then edit
# Load for node scripts (Node >=20.6):  node --env-file=.env scripts/<script>.mjs
# Load for curl / your shell:           set -a; . ./.env; set +a

# FRED — https://fredaccount.stlouisfed.org/apikeys
FRED_KEY=
# BLS Public Data API v2 — https://data.bls.gov/registrationEngine/
BLS_KEY=
# USDA AMS Market News (MARS) — https://mymarketnews.ams.usda.gov/  (Settings -> Request API Key)
AMS_KEY=
# EIA Open Data (diesel/freight signal) — https://www.eia.gov/opendata/register.php
EIA_KEY=
# USDA LMR Datamart (beef/pork wholesale) is typically KEYLESS — https://mpr.datamart.ams.usda.gov/
