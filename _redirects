# Cloudflare Pages _redirects
# https://developers.cloudflare.com/pages/configuration/redirects/
#
# URL history:
#   Sprint 1 origin      /audit/                    and /audit/restaurants/
#   First restructure    /tools/                    and /tools/restaurant-audit/
#   Current structure    /tools/ /tools/audits/ and /tools/audits/restaurant/
#
# The /tools/ category exists so we can expand beyond audits over time
# (generators, converters, analyzers, etc.) without another restructure.
# All legacy paths redirect forward to the current structure so external
# backlinks to any historical URL land correctly and pass SEO equity.
#
# Ordering matters: more specific paths come before their wildcards so
# Cloudflare Pages matches the exact rule first.

# Second restructure: /tools/restaurant-audit/ -> /tools/audits/restaurant/
/tools/restaurant-audit/     /tools/audits/restaurant/    301
/tools/restaurant-audit/*    /tools/audits/restaurant/:splat   301

# First restructure: /audit/* -> /tools/*
# Point the old /audit/restaurants/ path directly at the current
# /tools/audits/restaurant/ location so chained redirects don't
# waste a hop.
/audit/restaurants/          /tools/audits/restaurant/    301
/audit/                      /tools/                      301
/audit/*                     /tools/:splat                301

# Tools sunset (Sprint M, 2026-05-08): invoice-decoder + menu-design
# retired. No replacement was built; redirect to the tools catalog
# so visitors land on a clean index of what is shipping. Sub-paths
# included so stale service-worker / manifest / chunked-JS bookmarks
# don't 404 noisily.
#
# Why 301 instead of 410: Cloudflare Workers Builds rejects 410 in
# _redirects (validation error 10021 — only 200/301/302/303/307/308
# accepted). Pages would accept 410, but this site deploys via
# `wrangler versions upload`. 301 to /tools/ is the closest honest
# alternative — the catalog is where someone looking for a retired
# tool should land. The 404.html sunset-path scrub still handles
# orphan-PWA cleanup for any path that slips through.
#
# menu-polish is gone with no replacement; 301 to the surviving Menu
# Drop-In offer.
/tools/invoice-decoder/                          /tools/                        301
/tools/invoice-decoder/*                         /tools/                        301
/tools/menu-design/                              /tools/                        301
/tools/menu-design/*                             /tools/                        301
/es/tools/invoice-decoder/                       /es/tools/                     301
/es/tools/invoice-decoder/*                      /es/tools/                     301
/es/tools/menu-design/                           /es/tools/                     301
/es/tools/menu-design/*                          /es/tools/                     301
/services/menu-polish/                           /services/menu-drop-in/        301
/services/menu-polish/*                          /services/menu-drop-in/        301
/es/services/menu-polish/                        /es/services/menu-drop-in/     301
/es/services/menu-polish/*                       /es/services/menu-drop-in/     301

