# ============================================================
# Cloudflare Pages headers file
# ============================================================
#
# This file configures HTTP response headers for assets served
# by Cloudflare Pages. It is processed at deploy time by the
# Cloudflare Pages build pipeline and is completely ignored by
# GitHub Pages — so it's safe to keep this file in the repo
# during a parallel-hosting period.
#
# Syntax reference:
#   https://developers.cloudflare.com/pages/configuration/headers/
#
# Rule order matters: more specific paths should be declared
# BEFORE more general ones, because Pages applies the first
# matching rule for headers that share the same key.
#
# Editing this file:
#   1. Update the rules below
#   2. Commit + push — Cloudflare Pages triggers a redeploy
#      automatically and purges its edge cache for changed
#      assets
#   3. If visitors are seeing stale content after an update,
#      manually purge cache in Cloudflare dashboard:
#      Caching -> Configuration -> Purge Everything
#
# ============================================================


# ------------------------------------------------------------
# Static assets (CSS, JS)
# ------------------------------------------------------------
# CSS and JS get a SHORT browser cache (1 day) with a week-long
# stale-while-revalidate window. Filenames aren't fingerprinted,
# so a long cache silently breaks returning visitors any time we
# rename a class, add a new rule, or fix a JS bug — they keep
# getting old asset against new HTML until cache expires. The 1-
# day TTL means at worst, a stale visitor sees the bug for a day
# instead of a month; stale-while-revalidate keeps repeat-visit
# loads instant by serving cached and refetching in the
# background.
#
# Fonts stay on the long 30-day immutable cache below — woff2
# filenames embed the version stamp (e.g. fraunces-v38-...) so a
# stable filename is genuinely stable content.
#
# Manual override: bump a ?v=N query parameter on the <link>
# tag in the HTML for an immediate flush, or purge the
# Cloudflare edge cache from the dashboard.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, immutable

/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=2592000


# ------------------------------------------------------------
# Brand assets (SVGs, PNGs, logo marks)
# ------------------------------------------------------------
# Same 30-day browser cache. These rarely change — when they
# do (new logo, new OG card), same refresh instructions apply.
/brand/*
  Cache-Control: public, max-age=2592000


# ------------------------------------------------------------
# Downloadable checklist PDFs
# ------------------------------------------------------------
# Direct-download audit sheets generated by scripts/render-checklist-pdfs.mjs.
# 7-day browser cache so re-runs of the script propagate within a
# reasonable window without a manual purge.
/resources/*/muntin-*.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment
  Cache-Control: public, max-age=604800


# ------------------------------------------------------------
# Favicons and web manifest
# ------------------------------------------------------------
# 7-day cache. Favicons are the most visible to Google Search
# indexing, so we want a reasonable refresh window without
# forcing re-downloads on every visit.
/favicon.ico
  Cache-Control: public, max-age=604800

/brand/favicons/*
  Cache-Control: public, max-age=604800


# ------------------------------------------------------------
# Service worker (Wave 6.8 — Invoice Decoder PWA)
# ------------------------------------------------------------
# Service workers MUST NOT be aggressively cached — the browser
# checks the SW URL on every navigation to detect updates. A long
# cache here would trap users on stale tool versions for weeks.
# We use no-cache (the browser still keeps a copy but revalidates
# every time) plus max-age=0 for older caches that ignore no-cache.
# The Service-Worker-Allowed header is unnecessary because the SW
# is registered at the same path it lives in (/tools/invoice-decoder/).
/tools/invoice-decoder/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Tool-scoped manifest. Refresh window aligned with site manifest
# (1 hour) so a manifest-content change propagates within reasonable
# time without forcing re-downloads on every visit.
/tools/invoice-decoder/manifest.webmanifest
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8


# ------------------------------------------------------------
# HTML pages
# ------------------------------------------------------------
# Short browser cache (10 min) and a slightly longer edge
# cache (1 hour) so content updates propagate fast. The
# `stale-while-revalidate` tells browsers it's OK to show
# the cached copy while silently fetching a fresh one in
# the background — gives us instant perceived loads without
# blocking the update path.
#
# Content-Language: declared per locale so that browsers, CDNs,
# screen readers, and search engines treat /es/* as the Spanish
# surface of the site and / as the English surface. Rule order
# matters — the more specific /es/* block must come before the
# catch-all /*.html rule so Pages picks the Spanish header first.
/es/*
  Content-Language: es
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/
  Content-Language: en
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/*.html
  Content-Language: en
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400


# ------------------------------------------------------------
# Security headers — applied to EVERY response
# ------------------------------------------------------------
# These are the defensive baseline every production static
# site should have. None of them change how the site behaves
# for normal visitors, but they reduce the blast radius of
# the most common attack categories: clickjacking, MIME
# sniffing, referrer leakage, and overly permissive browser
# API access.
#
# Content-Security-Policy rationale:
#   default-src 'self'             — by default, only load from our origin
#   script-src                     — self for /assets/site.js, plausible.io
#                                    for analytics, cdn.jsdelivr.net for
#                                    the lazy-loaded jsPDF library used by
#                                    the restaurant-audit PDF-CTA flow
#                                    (Sprint L3), 'unsafe-inline' because
#                                    we still use inline JSON-LD blocks and
#                                    the Plausible init shim
#   style-src                      — self + fonts.googleapis.com (the four
#                                    pages still on Google Fonts) + inline
#                                    since we use style attributes and
#                                    page-level <style> blocks
#   font-src                       — self (/assets/fonts/*) + gstatic.com
#                                    for the four remaining Google-Fonts
#                                    pages
#   img-src                        — self + data: URIs for the inline SVGs
#                                    we use in the form select dropdown
#                                    and various small icons
#   connect-src                    — self + plausible.io (analytics beacons)
#                                    + googleapis.com for the PageSpeed
#                                    Insights API the audit tool calls.
#                                    Sprint 7d retired formspree.io (forms
#                                    now submit to our own /api/* endpoints
#                                    on the same origin via env.ASSETS +
#                                    src/worker.js)
#   form-action 'self'             — forms can only submit to us
#   frame-ancestors 'none'         — reinforces X-Frame-Options: DENY
#   frame-src 'none'               — we don't embed anything in iframes
#   object-src 'none'              — no legacy plugins allowed
#   base-uri 'self'                — prevents <base href> injection
#   upgrade-insecure-requests      — auto-upgrade any stray http:// refs
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://plausible.io https://www.googleapis.com; form-action 'self'; frame-ancestors 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests
