# ============================================================
# Cloudflare Pages headers file
# ============================================================
#
# This file configures HTTP response headers for assets served
# by Cloudflare Pages. It is processed at deploy time by the
# Cloudflare Pages build pipeline and is completely ignored by
# GitHub Pages — so it's safe to keep this file in the repo
# during a parallel-hosting period.
#
# Syntax reference:
#   https://developers.cloudflare.com/pages/configuration/headers/
#
# Rule order matters: more specific paths should be declared
# BEFORE more general ones, because Pages applies the first
# matching rule for headers that share the same key.
#
# Editing this file:
#   1. Update the rules below
#   2. Commit + push — Cloudflare Pages triggers a redeploy
#      automatically and purges its edge cache for changed
#      assets
#   3. If visitors are seeing stale content after an update,
#      manually purge cache in Cloudflare dashboard:
#      Caching -> Configuration -> Purge Everything
#
# ============================================================


# ------------------------------------------------------------
# Static assets (CSS, JS)
# ------------------------------------------------------------
# CSS and JS get a SHORT browser cache (1 day) with a week-long
# stale-while-revalidate window. Filenames aren't fingerprinted,
# so a long cache silently breaks returning visitors any time we
# rename a class, add a new rule, or fix a JS bug — they keep
# getting old asset against new HTML until cache expires. The 1-
# day TTL means at worst, a stale visitor sees the bug for a day
# instead of a month; stale-while-revalidate keeps repeat-visit
# loads instant by serving cached and refetching in the
# background.
#
# Fonts stay on the long 30-day immutable cache below — woff2
# filenames embed the version stamp (e.g. fraunces-v38-...) so a
# stable filename is genuinely stable content.
#
# Manual override: bump a ?v=N query parameter on the <link>
# tag in the HTML for an immediate flush, or purge the
# Cloudflare edge cache from the dashboard.
/assets/fonts/*
  Cache-Control: public, max-age=2592000, immutable

/assets/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/*
  Cache-Control: public, max-age=2592000


# ------------------------------------------------------------
# Brand assets (SVGs, PNGs, logo marks)
# ------------------------------------------------------------
# Same 30-day browser cache. These rarely change — when they
# do (new logo, new OG card), same refresh instructions apply.
/brand/*
  Cache-Control: public, max-age=2592000


# ------------------------------------------------------------
# Downloadable checklist PDFs
# ------------------------------------------------------------
# Direct-download audit sheets generated by scripts/render-checklist-pdfs.mjs.
# 7-day browser cache so re-runs of the script propagate within a
# reasonable window without a manual purge.
/resources/*/muntin-*.pdf
  Content-Type: application/pdf
  Content-Disposition: attachment
  Cache-Control: public, max-age=604800


# ------------------------------------------------------------
# Favicons and web manifest
# ------------------------------------------------------------
# 7-day cache. Favicons are the most visible to Google Search
# indexing, so we want a reasonable refresh window without
# forcing re-downloads on every visit.
/favicon.ico
  Cache-Control: public, max-age=604800

/brand/favicons/*
  Cache-Control: public, max-age=604800


# ------------------------------------------------------------
# Service worker (Wave 6.8 — Invoice Decoder PWA)
# ------------------------------------------------------------
# Tools sunset (Sprint M, 2026-05-08): invoice-decoder + menu-design
# retired. The SW kill-switches at /tools/{invoice-decoder,menu-
# design}/sw.js need no-cache + must-revalidate so the browser
# fetches the replacement on next navigation, runs activate, and
# unregisters cleanly. Once the tool directories are deleted the
# kill-switches go with them and these rules become no-ops.
/tools/invoice-decoder/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8
/tools/menu-design/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate
  Content-Type: application/javascript; charset=utf-8

# Sunset notice pages keep their own short cache so any final flip
# (e.g. Phase B → Phase E) propagates quickly through the edge.
/tools/invoice-decoder/
  Cache-Control: public, max-age=300, s-maxage=300
  X-Robots-Tag: noindex, follow
/tools/menu-design/
  Cache-Control: public, max-age=300, s-maxage=300
  X-Robots-Tag: noindex, follow
/es/tools/invoice-decoder/
  Cache-Control: public, max-age=300, s-maxage=300
  Content-Language: es
  X-Robots-Tag: noindex, follow
/es/tools/menu-design/
  Cache-Control: public, max-age=300, s-maxage=300
  Content-Language: es
  X-Robots-Tag: noindex, follow


# ------------------------------------------------------------
# Shared menu-renderers package (planned home for extracted
# pdf / html / text / themes / lint code; consumed by every menu
# tool — converter, engineering, copy, design).
# ------------------------------------------------------------
/tools/_shared/menu-renderers/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tools/_shared/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800


# ------------------------------------------------------------
# Vendored third-party libraries (jsPDF, JSZip, html2canvas,
# qrcode-generator). Version-pinned in path so the cache can be
# truly immutable. Mirrors the /assets/fonts/* posture.
# ------------------------------------------------------------
/assets/vendor/*
  Cache-Control: public, max-age=2592000, immutable

# Audit fix (build H7): ORT and other WASM blobs need
# Content-Type: application/wasm so the browser uses the
# streaming compile path (WebAssembly.instantiateStreaming).
# Cloudflare's default MIME inference often serves .wasm as
# application/octet-stream, which forces ORT to fall back to
# the slower non-streaming ArrayBuffer path or — in strict
# mode — fail the load. Path-scoped to .wasm files so other
# vendor assets (.mjs, .js, .onnx) keep their inferred types.
/assets/vendor/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=2592000, immutable


# ------------------------------------------------------------
# HTML pages
# ------------------------------------------------------------
# Short browser cache (10 min) and a slightly longer edge
# cache (1 hour) so content updates propagate fast. The
# `stale-while-revalidate` tells browsers it's OK to show
# the cached copy while silently fetching a fresh one in
# the background — gives us instant perceived loads without
# blocking the update path.
#
# Content-Language: declared per locale so that browsers, CDNs,
# screen readers, and search engines treat /es/* as the Spanish
# surface of the site and / as the English surface. Rule order
# matters — the more specific /es/* block must come before the
# catch-all /*.html rule so Pages picks the Spanish header first.
/es/*
  Content-Language: es
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/
  Content-Language: en
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400

/*.html
  Content-Language: en
  Cache-Control: public, max-age=600, s-maxage=3600, stale-while-revalidate=86400


# ------------------------------------------------------------
# Security headers — applied to EVERY response
# ------------------------------------------------------------
# These are the defensive baseline every production static
# site should have. None of them change how the site behaves
# for normal visitors, but they reduce the blast radius of
# the most common attack categories: clickjacking, MIME
# sniffing, referrer leakage, and overly permissive browser
# API access.
#
# Content-Security-Policy rationale:
#   default-src 'self'             — by default, only load from our origin
#   script-src                     — self for /assets/site.js + the
#                                    self-hosted Plausible tracker at
#                                    /assets/p.js (Phase 3B —
#                                    plausible.io was retired here
#                                    when the tracker moved on-domain),
#                                    challenges.cloudflare.com for the
#                                    Turnstile widget on the four public
#                                    form endpoints, 'unsafe-inline'
#                                    because we still use inline JSON-LD
#                                    blocks and the Plausible init shim,
#                                    NOTE: 'wasm-unsafe-eval' is
#                                    NOT in the global /* CSP. It's
#                                    only enabled in the path-scoped
#                                    /tools/invoice-decoder/* +
#                                    /es/tools/invoice-decoder/*
#                                    blocks because that's the only
#                                    surface that loads onnxruntime-
#                                    web for PP-OCRv3 inference. The
#                                    rest of the site stays tighter.
#   style-src                      — self + fonts.googleapis.com (the four
#                                    pages still on Google Fonts) + inline
#                                    since we use style attributes and
#                                    page-level <style> blocks
#   font-src                       — self (/assets/fonts/*) + gstatic.com
#                                    for the four remaining Google-Fonts
#                                    pages
#   img-src                        — self + data: URIs for the inline SVGs
#                                    we use in the form select dropdown
#                                    and various small icons
#   connect-src                    — self (analytics beacons go through
#                                    /api/event proxy on this same worker
#                                    after the Phase 3B Plausible
#                                    self-host) + googleapis.com for the
#                                    PageSpeed Insights API the audit
#                                    tool calls + challenges.cloudflare.com
#                                    for the Turnstile token verification
#                                    roundtrip. Sprint 7d retired
#                                    formspree.io (forms now submit to
#                                    our own /api/* endpoints on the
#                                    same origin via env.ASSETS +
#                                    src/worker.js)
#   form-action 'self'             — forms can only submit to us
#   frame-ancestors 'none'         — reinforces X-Frame-Options: DENY
#   frame-src 'self' + cf          — Turnstile renders the visible-challenge
#                                    fallback inside an iframe from
#                                    challenges.cloudflare.com
#   object-src 'none'              — no legacy plugins allowed
#   base-uri 'self'                — prevents <base href> injection
#   upgrade-insecure-requests      — auto-upgrade any stray http:// refs
# ------------------------------------------------------------
# Path-scoped CSP override — invoice decoder ONLY
# ------------------------------------------------------------
# Audit fix: 'wasm-unsafe-eval' is required for onnxruntime-web
# to compile its WASM kernels (PP-OCRv3 inference, DocLayNet
# layout, etc.). It does NOT need to be allowed on every page
# of muntin.digital — the homepage, glossary, blog, sheets,
# admin, etc. don't run WASM. Scoping it to the only paths
# that need it tightens the global posture: a compromised
# inline script on a non-decoder page can no longer compile
# arbitrary WASM modules.
#
# Two blocks because Cloudflare Pages _headers doesn't accept
# multi-path patterns. EN at /tools/invoice-decoder/*, ES at
# /es/tools/invoice-decoder/*. These come AFTER the /* block
# below because Cloudflare Pages applies _headers rules in
# order, with later rules overriding earlier ones for the
# same header. Production sighting: the previous version had
# /* placed last in the file, so its CSP (without
# 'wasm-unsafe-eval') silently overrode the path-scoped
# directive — Tesseract's WebAssembly.instantiate() failed
# with a clear CSP violation, the worker hung, and the
# operator saw "Reading the lines — about 48s left" until
# the per-page timeout fired.
#
# Additions in this version (also driven by the same console-
# error diagnosis):
#   connect-src adds data:  — Tesseract.js v5 ships its WASM
#     as base64-inlined data: URL inside the .wasm.js shim;
#     the shim does fetch(dataURL) which requires connect-src
#     to allow data:. Inline data: URLs are JS-constructed
#     and self-contained, so this doesn't widen the network
#     surface beyond what JS could already see.
#   img-src adds blob: — preprocess.js renders the cleaned
#     image into a blob URL for the "CLEANED FOR READING"
#     preview pane. Same-origin blob URL; same posture as
#     data:.
# ------------------------------------------------------------
# Global CSP — applied to every response
# ------------------------------------------------------------
# Audit fix retraction (2026-05-08): commit C5 (d7b71106) tried
# to path-scope 'wasm-unsafe-eval' to /tools/invoice-decoder/*
# only, on the security-purist principle that pages without
# WASM shouldn't permit it. The path-scoped block in Cloudflare
# Pages _headers turned out NOT to match the index page
# `/tools/invoice-decoder/` (with trailing slash) — the
# `*` glob requires at least one character after it. The global
# `/*` block kept winning, served a CSP without wasm-unsafe-eval,
# and Tesseract's WebAssembly.instantiate() failed silently.
# Six hotfixes today were dragnet attempts to find this; only
# console.log of the actual served CSP confirmed it.
#
# Pragmatic resolution: put the wide CSP in /* (the only block
# that matches every URL reliably). The "loss" is small:
#   wasm-unsafe-eval — only unlocks WebAssembly compilation;
#     does NOT unlock JS eval(), so an inline script on a
#     non-decoder page can compile WASM but can't execute
#     arbitrary script via eval. A compromised inline script
#     could already do anything 'unsafe-inline' allows; WASM
#     compile is a marginal addition.
#   data: in connect-src — allows fetch() of inline data URLs.
#     Tesseract's .wasm.js shim ships its WASM as base64-
#     inlined data: URL and fetches it. Inline data URLs are
#     constructed in JS, not from external sources, so this
#     doesn't widen the network surface.
#   blob: in img-src — preprocess.js renders the cleaned
#     image into a same-origin blob URL for the preview pane.
#     Blob URLs are local references, not external.
# Rolling these site-wide is preferable to letting the tool
# stay broken. The audit's privacy contract on /tools/invoice-
# decoder/ specifically — connect-src 'self', no third-party
# script-src, no plausible.io — is unchanged. This widening
# is for ANY-page WASM compilation + same-origin local data
# URLs, neither of which is an exfil channel.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' data: https://www.googleapis.com https://challenges.cloudflare.com; form-action 'self'; frame-ancestors 'none'; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; worker-src 'self' blob:; upgrade-insecure-requests
