<!-- Tasker profile for the Muntin Invoice Decoder.
     Trigger: new Gmail message tagged "Invoices" with a PDF attachment.
     Action: save attachment to /sdcard/Invoices/, open the PWA's
             share-target deeplink, hand off the file via intent. -->
<TaskerData sr="" dvi="1" tv="6.3.4">
  <Profile sr="prof1" ve="2">
    <cdate>1746374400000</cdate>
    <id>1</id>
    <mid0>1</mid0>
    <nme>Forward to Invoice Decoder</nme>
    <pri>10</pri>
    <Event sr="con0" ve="2">
      <code>305</code>
      <pri>5</pri>
      <Str sr="arg0" ve="3">com.google.android.gm</Str>
      <Str sr="arg1" ve="3">Invoices</Str>
      <Int sr="arg2" val="1"/>
      <Int sr="arg3" val="0"/>
    </Event>
  </Profile>
  <Task sr="task1">
    <cdate>1746374400000</cdate>
    <id>1</id>
    <nme>Invoice Decoder Forward</nme>
    <pri>10</pri>
    <Action sr="act0" ve="7">
      <code>409</code>
      <Str sr="arg0" ve="3">/sdcard/Invoices/%TIMES.pdf</Str>
      <Int sr="arg1" val="0"/>
    </Action>
    <Action sr="act1" ve="7">
      <code>104</code>
      <Str sr="arg0" ve="3">android.intent.action.SEND</Str>
      <Str sr="arg1" ve="3">application/pdf</Str>
      <Str sr="arg2" ve="3">https://muntin.digital/tools/invoice-decoder/?intake=share</Str>
      <Str sr="arg3" ve="3">file:///sdcard/Invoices/%TIMES.pdf</Str>
    </Action>
  </Task>
</TaskerData>
