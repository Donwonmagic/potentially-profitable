{
  "name": "Muntin Invoice Decoder",
  "short_name": "Decoder",
  "description": "Snap a supplier invoice. Sort it. Keep it on your phone, encrypted.",
  "lang": "en",
  "dir": "ltr",
  "scope": "/tools/invoice-decoder/",
  "start_url": "/tools/invoice-decoder/?source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1F4E5B",
  "background_color": "#FAF6EE",
  "categories": ["business", "productivity", "finance"],
  "icons": [
    { "src": "/brand/favicons/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/favicons/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/favicons/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/favicons/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Snap an invoice",
      "short_name": "Snap",
      "url": "/tools/invoice-decoder/?action=photo",
      "description": "Open the camera and snap a supplier invoice",
      "icons": [{ "src": "/brand/favicons/android-chrome-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open Workshop",
      "short_name": "Workshop",
      "url": "/workbench/",
      "description": "View your saved invoices"
    }
  ],
  "share_target": {
    "action": "/tools/invoice-decoder/share-handler",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "invoice",
          "accept": [
            "image/*",
            "image/jpeg",
            "image/png",
            "image/heic",
            "image/heif",
            "application/pdf"
          ]
        }
      ]
    }
  },
  "screenshots": [
    {
      "src": "/brand/og/tool-invoice-decoder.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Invoice Decoder hero — snap a photo of any distributor invoice"
    }
  ],
  "prefer_related_applications": false
}
