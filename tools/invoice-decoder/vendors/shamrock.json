{
  "id": "shamrock",
  "schemaVersion": 1,
  "label": {
    "en": "Shamrock Foods",
    "es": "Shamrock Foods"
  },
  "detect": {
    "minScore": 0.5,
    "tokens": [
      {
        "pattern": "shamrock\\s+foods",
        "weight": 0.6
      },
      {
        "pattern": "\\bshamrock\\b",
        "weight": 0.4
      },
      {
        "pattern": "phoenix|denver|albuquerque|salt\\s+lake",
        "weight": 0.1
      },
      {
        "pattern": "clover\\s*pricing|clover\\s*list",
        "weight": 0.15
      }
    ]
  },
  "headerSkip": [
    "^item\\s+class",
    "^prod\\s*#\\s+description"
  ],
  "confidenceBoost": 10,
  "lineGrammar": {
    "_doc": "Shamrock prints sales tax on non-food at the foot. 'Clover Pricing' contract rows surface as deal allowances when the operator buys above a threshold.",
    "taxPatterns": [
      "\\b(sales|state|local|city|county)\\s+tax\\b",
      "\\b(non[- ]?food|paper|chemical)\\s+tax\\b"
    ],
    "discountPatterns": [
      "\\b(volume|case|clover|loyalty)\\s+(allowance|discount|rebate)\\b",
      "\\b(mcb|manufacturer\\s+chargeback|deal\\s+allowance)\\b"
    ]
  }
}
