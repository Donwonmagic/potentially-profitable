{
  "name": "Muntin Menu Design Suite",
  "short_name": "Menu Design",
  "description": "Auto-layout restaurant menus into print PDFs, QR-menu HTML, and accessible text. 25 themes, 22 paper sizes, 17 allergens. Runs in your browser; nothing uploads.",
  "lang": "en",
  "dir": "ltr",
  "scope": "/tools/menu-design/",
  "start_url": "/tools/menu-design/?source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "theme_color": "#1F4E5B",
  "background_color": "#FAF6EE",
  "categories": ["business", "productivity", "food"],
  "icons": [
    { "src": "/brand/favicons/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/brand/favicons/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/brand/favicons/android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/favicons/android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Start a new menu",
      "short_name": "New menu",
      "url": "/tools/menu-design/?action=new",
      "description": "Start a fresh menu from scratch"
    },
    {
      "name": "Spanish version",
      "short_name": "Español",
      "url": "/es/tools/menu-design/",
      "description": "Open the Spanish edition"
    }
  ],
  "screenshots": [
    {
      "src": "/brand/og/tool-menu-design.png",
      "sizes": "1200x630",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Menu Design Suite hero — auto-layout for any restaurant menu, 25 themes, 22 paper sizes"
    }
  ],
  "prefer_related_applications": false
}
