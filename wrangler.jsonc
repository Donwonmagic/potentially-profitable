{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muntin-digital",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true
  },
  // Worker entry point. Sprint 7a introduces a small Worker script
  // at src/worker.js that handles /api/* routes for form submissions
  // (intake, checklist PDF, audit-report email) and falls through to
  // env.ASSETS.fetch() for every other request. Before Sprint 7 the
  // site was pure-static with no Worker code; this line turns it
  // into a Worker that ALSO serves static assets.
  "main": "./src/worker.js",
  // Cloudflare Workers with Static Assets refuses to treat the repo
  // root as an assets directory (it would try to upload wrangler.jsonc,
  // .git/, .github/workflows/, docs/, and everything else). We stage a
  // clean dist/ subdirectory at build time by tarring the repo (with
  // excludes) and extracting into dist/.
  //
  // Why tar and not rsync: Cloudflare's build container is minimal and
  // does NOT have rsync installed. It DOES have tar, mkdir, and sh.
  // The pipe `tar -cf - ... | tar -xf - -C dist` is the POSIX-standard
  // way to do a selective directory copy without external tools.
  //
  // The excludes cover:
  //   dist          — the staging target itself (avoid infinite loop)
  //   .git          — source control metadata
  //   .github       — GitHub Actions workflows (never served)
  //   docs          — developer runbooks, not user-facing
  //   node_modules  — not present today, exclude defensively
  //   .wrangler     — Wrangler's local cache
  //   .env*         — any secrets files
  //   wrangler.jsonc — this config file itself (not a static asset)
  //   package*.json — defensive exclude if we ever add Node tooling
  //   .gitignore    — git metadata
  //   src           — Sprint 7a: Worker source (referenced by "main"
  //                   above, NOT a static asset)
  //   scripts       — build-time Node scripts (sync-includes.mjs,
  //                   render-checklist-pdfs.mjs). Referenced by the
  //                   build command, never served to users.
  //   _includes     — canonical HTML partials (nav, footer) consumed
  //                   by scripts/sync-includes.mjs. Not user-facing.
  //
  // The _headers file at the repo root IS copied into dist/ because it's
  // a static asset that Workers Static Assets interprets at deploy time
  // for per-path cache and security headers. Same with /favicon.ico,
  // /sitemap.xml, /robots.txt, /CNAME.
  //
  // The `node scripts/sync-includes.mjs` step stamps the canonical nav
  // and footer from _includes/ into every HTML page before the tar.
  // It's idempotent — a no-op if source is already in sync — and
  // guarantees that a stale page can't ship.
  "build": {
    // i18n build steps run in order BEFORE the tar:
    //   sync-includes.mjs       — stamps locale-aware nav/footer
    //                             (English + Spanish partials under
    //                             _includes/es/) into every HTML page
    //   stamp-hreflang.mjs      — injects <link rel="alternate"
    //                             hreflang="..."> + og:locale blocks
    //                             after each page's canonical tag.
    //                             Idempotent, safe to re-run
    //   check-locale-parity.mjs — warns about missing Spanish pages or
    //                             stale Spanish copies. Uses --check in
    //                             warn-only mode during rollout; flip
    //                             to hard-fail once ES coverage is
    //                             complete (see the script's tail)
    //   stamp-es-restaurant-audit.mjs — ES4: regenerates the Spanish
    //                             mirror of the restaurant audit from
    //                             the EN master so i18n changes land
    //                             in both locales automatically.
    "command": "node scripts/sync-includes.mjs && node scripts/stamp-hreflang.mjs && node scripts/stamp-es-restaurant-audit.mjs && node scripts/check-locale-parity.mjs --check && mkdir -p dist && tar -cf - --exclude=dist --exclude=.git --exclude=.github --exclude=docs --exclude=node_modules --exclude=.wrangler --exclude='.env*' --exclude=wrangler.jsonc --exclude='package*.json' --exclude=.gitignore --exclude=README.md --exclude=src --exclude=scripts --exclude=_includes . | tar -xf - -C dist"
  },
  "assets": {
    "directory": "./dist",
    // Bind the static-asset server to env.ASSETS so the Worker can
    // fall through to it for non-/api/* paths. Default binding name
    // is ASSETS but making it explicit for clarity.
    "binding": "ASSETS"
  },
  // Non-secret environment variables consumed by the Sprint 7c form
  // handlers. FROM_EMAIL is the sender address that shows up in the
  // notification + auto-responder emails — must be on a verified
  // domain in Resend (set up during Sprint 7d deploy). NOTIFY_EMAIL
  // is where form submissions are forwarded (Don's real inbox).
  //
  // The RESEND_API_KEY is a SECRET, not a var, and is injected via
  // `wrangler secret put RESEND_API_KEY` during deploy. It must
  // never appear in this file or the git history.
  //
  // Other secrets consumed by the Worker (set via `wrangler secret
  // put X`; never committed):
  //   PSI_API_KEY        — Google PageSpeed Insights proxy (/api/psi)
  //   GOOGLE_PLACES_KEY  — Google Places v1 lookup (/api/gbp-lookup)
  //   RESEND_API_KEY     — Resend transactional email (lib/email.js)
  //
  // /api/ping exposes a boolean for each configured secret so ops
  // can verify plumbing without exercising the upstream.
  "vars": {
    "FROM_EMAIL":   "Don Goldstein <don@muntin.digital>",
    "NOTIFY_EMAIL": "don@muntin.digital"
  },

  // ─────────────────────────────────────────────────────────────────
  // Durable Object: global per-IP rate limiter (activated Phase 1).
  //
  // Class definition lives in src/lib/rate-limiter-do.js and is re-
  // exported from src/worker.js. The first `wrangler deploy` after
  // this block was uncommented runs the v1 migration and creates the
  // RateLimiter class on Cloudflare's side. Worker code checks for
  // env.RATE_LIMITER at request time: when the binding is present
  // the Worker calls the DO (global sliding window); when absent the
  // in-isolate limiter in rate-limit.js is the fallback. Both paths
  // are exercised by scripts/test-rate-limit* tests.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  // Cloudflare Workers free plan only supports DOs backed by SQLite
  // storage (the older KV-backed DOs are paid-plan only). The class
  // definition in src/lib/rate-limiter-do.js is unchanged — both
  // backends expose the same `state.storage.get/put` API. The
  // distinction is purely in the migration directive.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ]

  // ─────────────────────────────────────────────────────────────────
  // Optional KV bindings (provisioned on demand):
  //
  // Sprint T3 — AUDIT_CACHE:
  // Create the namespace via `wrangler kv:namespace create AUDIT_CACHE`
  // and paste the returned id below. The Worker's src/lib/audit-cache.js
  // reads env.AUDIT_CACHE when present and caches PSI / Places / schema
  // / crawl responses for 1-6 hours keyed by URL. When the binding is
  // absent, every cache call no-ops and the audit runs identically to
  // today — no code change required when the binding appears.
  //
  // D1 — AUDIT_SNAPSHOTS:
  // Create via `wrangler kv:namespace create AUDIT_SNAPSHOTS`. Backs the
  // /api/audit-snapshot endpoint (src/lib/audit-snapshots.js) — persists
  // serialized audit state so the owner can share a permalink instead of
  // downloading a PDF. 90-day TTL, ~30-80 KB per snapshot, token is the
  // only gate (unlisted resource, not secret). When the binding is
  // absent the endpoint returns 503 with error=snapshot-storage-
  // unavailable and the audit tool keeps working without share links.
  //
  //   "kv_namespaces": [
  //     { "binding": "AUDIT_CACHE",     "id": "<paste-from-wrangler-output>" },
  //     { "binding": "AUDIT_SNAPSHOTS", "id": "f661208f47644e32bfe965e46f42f88a" }
  //   ]
  //
  // And for the AI Gateway that powers the facts dossier (T4):
  //
  //   "ai": {
  //     "binding": "AI"
  //   }
  //
  // Plus a secret: `wrangler secret put ANTHROPIC_API_KEY`.
  // ─────────────────────────────────────────────────────────────────
}
