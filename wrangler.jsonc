{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muntin-digital",
  "compatibility_date": "2026-04-15",
  "observability": {
    "enabled": true
  },
  // Worker entry point. Sprint 7a introduces a small Worker script
  // at src/worker.js that handles /api/* routes for form submissions
  // (intake, checklist PDF, audit-report email) and falls through to
  // env.ASSETS.fetch() for every other request. Before Sprint 7 the
  // site was pure-static with no Worker code; this line turns it
  // into a Worker that ALSO serves static assets.
  "main": "./src/worker.js",
  // Cloudflare Workers with Static Assets refuses to treat the repo
  // root as an assets directory (it would try to upload wrangler.jsonc,
  // .git/, .github/workflows/, docs/, and everything else). We stage a
  // clean dist/ subdirectory at build time by tarring the repo (with
  // excludes) and extracting into dist/.
  //
  // Why tar and not rsync: Cloudflare's build container is minimal and
  // does NOT have rsync installed. It DOES have tar, mkdir, and sh.
  // The pipe `tar -cf - ... | tar -xf - -C dist` is the POSIX-standard
  // way to do a selective directory copy without external tools.
  //
  // The excludes cover:
  //   dist          — the staging target itself (avoid infinite loop)
  //   .git          — source control metadata
  //   .github       — GitHub Actions workflows (never served)
  //   docs          — developer runbooks, not user-facing
  //   node_modules  — not present today, exclude defensively
  //   .wrangler     — Wrangler's local cache
  //   .env*         — any secrets files
  //   wrangler.jsonc — this config file itself (not a static asset)
  //   package*.json — defensive exclude if we ever add Node tooling
  //   .gitignore    — git metadata
  //   src           — Sprint 7a: Worker source (referenced by "main"
  //                   above, NOT a static asset)
  //   scripts       — build-time Node scripts (sync-includes.mjs,
  //                   stamp-hreflang.mjs, etc). Referenced by the
  //                   build command, never served to users.
  //   _includes     — canonical HTML partials (nav, footer) consumed
  //                   by scripts/sync-includes.mjs. Not user-facing.
  //
  // The _headers file at the repo root IS copied into dist/ because it's
  // a static asset that Workers Static Assets interprets at deploy time
  // for per-path cache and security headers. Same with /favicon.ico,
  // /sitemap.xml, /robots.txt, /CNAME.
  //
  // The `node scripts/sync-includes.mjs` step stamps the canonical nav
  // and footer from _includes/ into every HTML page before the tar.
  // It's idempotent — a no-op if source is already in sync — and
  // guarantees that a stale page can't ship.
  "build": {
    // i18n build steps run in order BEFORE the tar:
    //   build-og-cards.mjs      — renders every OG card declared in
    //                             brand/og/cards.json through a typed
    //                             template. Shells out to rsvg-convert
    //                             when available (CF Pages) with
    //                             fontconfig pointed at Fraunces +
    //                             Inter TTFs. Content-based skip: if
    //                             the committed SVG matches template
    //                             output and the PNG exists, no render
    //                             needed — so a rendererless CF
    //                             environment can still pass.
    //   stamp-es-restaurant-audit.mjs — ES4: regenerates the Spanish
    //                             mirror of the restaurant audit from
    //                             the EN master. MUST run before
    //                             sync-includes — the regeneration
    //                             installs the EN nav, then
    //                             sync-includes overwrites it with the
    //                             Spanish nav partial. Reversing the
    //                             order wipes Spanish nav on every
    //                             deploy.
    //   sync-includes.mjs       — stamps locale-aware nav/footer
    //                             (English + Spanish partials under
    //                             _includes/es/) into every HTML page.
    //   stamp-hreflang.mjs      — injects <link rel="alternate"
    //                             hreflang="..."> + og:locale blocks
    //                             after each page's canonical tag.
    //                             Idempotent, safe to re-run.
    //   check-locale-parity.mjs — warns about missing Spanish pages or
    //                             stale Spanish copies. Uses --check in
    //                             warn-only mode during rollout; flip
    //                             to hard-fail once ES coverage is
    //                             complete (see the script's tail).
    //   check-og-images.mjs     — fails the build if any HTML page's
    //                             og:image / twitter:image meta
    //                             references a file that does not
    //                             exist in brand/og/. Catches stale
    //                             slugs + forgotten cards.json
    //                             entries before they ship.
    //   build-tools-index.mjs   — renders /tools/index.html and
    //                             /es/tools/index.html bodies between
    //                             <!-- tools:auto -->...<!-- /tools:auto -->
    //                             sentinels from data/tools.json (4
    //                             topic clusters, goals launcher, chip
    //                             nav, roadmap). Runs BEFORE
    //                             build-site-counts so the JSON it
    //                             consumes drives both the rendered
    //                             page and the cross-page count
    //                             sentinels.
    //   build-site-counts.mjs   — derives data/site-counts.json from
    //                             data/tools.json + filesystem (live
    //                             tool count, coming-soon count,
    //                             glossary terms, topics, articles).
    //                             Runs after sync-includes so the
    //                             freshly-stamped nav sentinels are in
    //                             place, and before inject-site-counts.
    //   inject-site-counts.mjs  — replaces <!-- count:KEY -->...<!-- /count -->
    //                             sentinels with values from
    //                             data/site-counts.json. MUST run after
    //                             sync-includes (which resets nav
    //                             sentinels to their template defaults).
    //   inject-tool-knit.mjs    — stamps the "Keep going" 4-column
    //                             footer block (topic, related tools,
    //                             articles, glossary) into every live
    //                             tool page, between <!-- tool-knit -->
    //                             sentinels. Reads data/tool-knit.json
    //                             + data/tools.json + data/topics.json
    //                             and extracts glossary labels from the
    //                             entry pages' <h1 class="term-h1">.
    //   wire-glossary-topics.mjs — stamps data-topics="topic1 topic2"
    //                             onto every <article class="gloss-term">
    //                             in glossary/index.html (EN + ES) so
    //                             the topic-cluster filter chips can
    //                             hide non-matching terms via CSS.
    //                             Source of truth: data/library-tags.json.
    //   wire-glossary-knit.mjs   — stamps the "Keep going" 4-column
    //                             footer (topic / used-in-tools /
    //                             articles / related-terms) onto every
    //                             glossary entry page (EN + ES) between
    //                             <!-- glossary-knit --> sentinels.
    //   build-library-recent.mjs — renders the 3-card "Recently added"
    //                             strip on /learn/ (EN + ES) between
    //                             <!-- recently-added --> sentinels.
    //                             Pulls dates from data/tools.json
    //                             (.added) and data/library-tags.json
    //                             (.blog_posts.date), sorts desc.
    //   pagefind                — builds the static search index after
    //                             the dist/ tree is materialized. Uses
    //                             npx -y so no package.json is needed;
    //                             outputs dist/pagefind/ which site.js
    //                             lazy-loads on first open of the
    //                             search modal. Config at pagefind.yml.
    "command": "node scripts/build-og-cards.mjs && node scripts/stamp-es-restaurant-audit.mjs && node scripts/sync-includes.mjs && node scripts/build-tools-index.mjs && node scripts/build-library-recent.mjs && node scripts/build-site-counts.mjs && node scripts/inject-site-counts.mjs && node scripts/inject-tool-knit.mjs && node scripts/wire-glossary-topics.mjs && node scripts/wire-glossary-knit.mjs && node scripts/stamp-hreflang.mjs && node scripts/check-locale-parity.mjs --check && node scripts/check-og-images.mjs && mkdir -p dist && tar -cf - --exclude=dist --exclude=.git --exclude=.github --exclude=docs --exclude=node_modules --exclude=.wrangler --exclude='.env*' --exclude=wrangler.jsonc --exclude='package*.json' --exclude=.gitignore --exclude=README.md --exclude=src --exclude=scripts --exclude=_includes --exclude=pagefind.yml . | tar -xf - -C dist && npx -y pagefind@latest --site dist"
  },
  "assets": {
    "directory": "./dist",
    // Bind the static-asset server to env.ASSETS so the Worker can
    // fall through to it for non-/api/* paths. Default binding name
    // is ASSETS but making it explicit for clarity.
    "binding": "ASSETS"
  },
  // Non-secret environment variables consumed by the Sprint 7c form
  // handlers. FROM_EMAIL is the sender address that shows up in the
  // notification + auto-responder emails — must be on a verified
  // domain in Resend (set up during Sprint 7d deploy). NOTIFY_EMAIL
  // is where form submissions are forwarded (Don's real inbox).
  //
  // The RESEND_API_KEY is a SECRET, not a var, and is injected via
  // `wrangler secret put RESEND_API_KEY` during deploy. It must
  // never appear in this file or the git history.
  //
  // Other secrets consumed by the Worker (set via `wrangler secret
  // put X`; never committed):
  //   PSI_API_KEY         — Google PageSpeed Insights proxy (/api/psi)
  //   GOOGLE_PLACES_KEY   — Google Places v1 lookup (/api/gbp-lookup)
  //   RESEND_API_KEY      — Resend transactional email (lib/email.js)
  //   AUTH_COOKIE_SECRET  — HMAC key for signed session cookies
  //                          (src/lib/auth.js). Generate with
  //                          `openssl rand -hex 32` and set via
  //                          `wrangler secret put AUTH_COOKIE_SECRET`
  //                          BEFORE first deploy that exposes the
  //                          /api/auth/* routes. Sprint 0 keeps these
  //                          routes private (no public sign-in UI),
  //                          but they must still be plumbed before
  //                          Phase 2 turns them on.
  //
  // /api/ping exposes a boolean for each configured secret so ops
  // can verify plumbing without exercising the upstream.
  "vars": {
    "FROM_EMAIL":          "Don Goldstein <don@muntin.digital>",
    "NOTIFY_EMAIL":        "don@muntin.digital",
    // Public origin used to build absolute magic-link URLs in the
    // sign-in email. Same value across envs today; if a preview env
    // ever needs to diverge, override here per environment.
    "MAGIC_LINK_BASE_URL": "https://muntin.digital"
  },

  // ─────────────────────────────────────────────────────────────────
  // Durable Object: global per-IP rate limiter (activated Phase 1).
  //
  // Class definition lives in src/lib/rate-limiter-do.js and is re-
  // exported from src/worker.js. The first `wrangler deploy` after
  // this block was uncommented runs the v1 migration and creates the
  // RateLimiter class on Cloudflare's side. Worker code checks for
  // env.RATE_LIMITER at request time: when the binding is present
  // the Worker calls the DO (global sliding window); when absent the
  // in-isolate limiter in rate-limit.js is the fallback. Both paths
  // are exercised by scripts/test-rate-limit* tests.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  // Cloudflare Workers free plan only supports DOs backed by SQLite
  // storage (the older KV-backed DOs are paid-plan only). The class
  // definition in src/lib/rate-limiter-do.js is unchanged — both
  // backends expose the same `state.storage.get/put` API. The
  // distinction is purely in the migration directive.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }
  ],

  // D1 / Sprint 3C — AUDIT_SNAPSHOTS KV binding activated. Backs
  // /api/audit-snapshot (src/lib/audit-snapshots.js): 90-day TTL,
  // ~30-80 KB per snapshot, unlisted-resource security model
  // (token is the only gate). Powers both the restaurant audit's
  // share URLs and the GBP grader's share URLs.
  //
  // Sprint 0 (Workshop foundation) — AUTH_SESSIONS KV binding for
  // magic-link sign-in (src/lib/auth.js). Two key prefixes:
  //   magic:<TOKEN10>      — 15-min one-shot magic-link tokens
  //   user:<sha256(email)> — lifetime user record { createdAt, lastSeenAt }
  // Sessions are signed-cookie only (no session: keys), so this
  // namespace stays small. Kept distinct from AUDIT_SNAPSHOTS
  // because the TTL contracts are incompatible (15 min vs 90 days)
  // and mixing would muddy ops dashboards. Replace the placeholder
  // id below by running:
  //   wrangler kv:namespace create AUTH_SESSIONS
  // and pasting the returned id. Until then, the worker handler
  // for /api/auth/* will see env.AUTH_SESSIONS === undefined and
  // return 503 (binding-not-configured) rather than silently
  // accepting requests it can't persist.
  "kv_namespaces": [
    { "binding": "AUDIT_SNAPSHOTS", "id": "f661208f47644e32bfe965e46f42f88a" },
    { "binding": "AUTH_SESSIONS",   "id": "REPLACE_WITH_AUTH_SESSIONS_ID_FROM_WRANGLER" }
  ]

  // ─────────────────────────────────────────────────────────────────
  // Optional bindings still staged, provisioned on demand:
  //
  // Sprint T3 — AUDIT_CACHE:
  // Create the namespace via `wrangler kv:namespace create AUDIT_CACHE`
  // and add the returned id to the kv_namespaces array above. The
  // Worker's src/lib/audit-cache.js reads env.AUDIT_CACHE when
  // present and caches PSI / Places / schema / crawl responses for
  // 1-6 hours. When the binding is absent, every cache call no-ops
  // and the audit runs identically to today — no code change
  // required when the binding appears.
  //
  // And for the AI Gateway that powers the facts dossier (T4):
  //
  //   "ai": {
  //     "binding": "AI"
  //   }
  //
  // Plus a secret: `wrangler secret put ANTHROPIC_API_KEY`.
  // ─────────────────────────────────────────────────────────────────
}
