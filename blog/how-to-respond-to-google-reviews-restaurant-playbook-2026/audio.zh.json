    {
      "id": 4,
      "kind": "body",
      "selector": "#post-body > p:nth-of-type(2)",
      "text": "评论 · 2026年5月10日 · 阅读时间7分钟 · 作者Don Goldstein",
      "start": 42.07,
      "end": 48.58
